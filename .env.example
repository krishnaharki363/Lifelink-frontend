# LifeLink Frontend — Environment Variables
# ─────────────────────────────────────────
# Copy this file to .env.local for local development.
# For production, set these in your Vercel project settings (Settings → Environment Variables).
# NEVER commit .env.local to version control.

# Backend API base URL (no trailing slash)
# Local dev:   http://localhost:5000/api/v1
# Production:  https://<your-render-service>.onrender.com/api/v1
VITE_API_URL=http://localhost:5000/api/v1
